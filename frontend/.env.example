# ===================================================================
# StratPool App Template – Frontend Environment Variables
# In production, set these in Coolify under your service.
# ===================================================================

# Supabase – the public anon key is safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://supabase.stratpool.pro
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Backend API URL
# - Local dev: http://localhost:8000
# - In Docker Compose / Coolify: http://backend:8000 (service name)
BACKEND_API_URL=http://backend:8000
