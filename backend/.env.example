# ===================================================================
# StratPool App Template – Backend Environment Variables
# Copy this file to `.env` for local dev. In production, set these
# in Coolify under your service's "Environment Variables" tab.
# ===================================================================

# App
APP_NAME=stratpool-app
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-XXXX
ANTHROPIC_MODEL=claude-opus-4-7

# Voyage AI
VOYAGE_API_KEY=pa-XXXX
VOYAGE_MODEL=voyage-3-large

# Supabase
SUPABASE_URL=https://supabase.stratpool.pro
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@supabase-db:5432/postgres

# JWT (use the JWT_SECRET from Supabase – Settings → API)
JWT_SECRET=your-supabase-jwt-secret-here-32-chars-min
JWT_ALGORITHM=HS256
