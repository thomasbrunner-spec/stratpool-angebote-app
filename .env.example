# ===================================================================
# StratPool App Template – Compose Environment
# Copy to .env for local dev. Coolify injects these via UI in production.
# ===================================================================

# App identity
COMPOSE_PROJECT_NAME=stratpool-app-template
APP_NAME=stratpool-app
ENVIRONMENT=development
DEBUG=true

# Frontend
SERVICE_FQDN_FRONTEND=app.stratpool.pro
CORS_ORIGINS=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-XXXX
ANTHROPIC_MODEL=claude-opus-4-7

# Voyage AI
VOYAGE_API_KEY=pa-XXXX
VOYAGE_MODEL=voyage-3-large

# Supabase
SUPABASE_URL=https://supabase.stratpool.pro
SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# JWT secret from Supabase
JWT_SECRET=your-supabase-jwt-secret

# GitHub Packages token (build secret for installing @thomasbrunner-spec/design-system)
GITHUB_PACKAGES_TOKEN=ghp_XXXX
